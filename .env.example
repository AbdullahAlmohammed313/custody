# Copy this file to .env and adjust the values for your machine

# PostgreSQL connection URL: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://postgres:password@localhost:5432/custody

# Random secret of at least 32 characters; generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# URL of this server
BETTER_AUTH_URL=http://localhost:5000

# Frontend URL allowed to call the API
FRONTEND_URL=http://localhost:3000

# Server port, default 5000
PORT=5000

# First admin account, used only by npm run db:seed
SEED_ADMIN_NAME=System Manager
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
